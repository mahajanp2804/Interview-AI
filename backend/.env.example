# Copy this file to .env and fill in your values
# Get your free key at: https://aistudio.google.com -> Get API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Any current Gemini model id: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=sqlite+aiosqlite:///./interviewai.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to true when serving over HTTPS, so sign-in cookies are never sent over plain HTTP
COOKIE_SECURE=false
# text or json
LOG_FORMAT=text
AI_RATE_LIMIT=30/minute
AUTH_RATE_LIMIT=10/minute
